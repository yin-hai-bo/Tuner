page {
  min-height: 100vh;
  background: #101413;
  color: #f2f5f3;
}

.settings { padding: 48rpx 32rpx; }
.heading { font-size: 32rpx; }
.language-options {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  background: #202925;
}
.option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
  font-size: 24rpx;
}
