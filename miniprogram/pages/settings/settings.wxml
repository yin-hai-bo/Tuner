<view class="settings">
  <text class="heading">{{messages.language}}</text>
  <radio-group class="language-options" bindchange="selectLanguage" aria-label="{{messages.language}}">
    <label class="option">
      <radio value="system" checked="{{preference === 'system'}}" color="#00cba9" />
      <text>{{followSystem}}</text>
    </label>
    <label class="option">
      <radio value="zh-CN" checked="{{preference === 'zh-CN'}}" color="#00cba9" />
      <text>简体中文</text>
    </label>
    <label class="option">
      <radio value="en" checked="{{preference === 'en'}}" color="#00cba9" />
      <text>English</text>
    </label>
  </radio-group>
</view>
