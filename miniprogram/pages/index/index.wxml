<view class="tuner">
  <view class="pitch-grid" aria-hidden="true"></view>
  <view class="toolbar">
    <label class="auto-control">
      <text>{{messages.automatic}}</text>
      <switch checked="{{selection.mode === 'auto'}}" color="#00cba9" bindchange="toggleAutomatic" aria-label="{{messages.automatic}}" />
    </label>
  </view>
  <view class="headstock">
    <view class="pitch-feedback">
      <text class="pitch-hint">{{pluckHint}}</text>
    </view>
    <image class="headstock-image" src="/assets/guitar-headstock.svg" mode="aspectFit" aria-hidden="true"></image>
    <view class="tuners left">
      <view wx:for="{{leftTuners}}" wx:key="number" class="tuning-peg {{selection.target && selection.target.number === item.number ? 'selected' : ''}}" style="top: {{(161 + index * 120) / 720 * 100}}%;" data-number="{{item.number}}" bindtap="selectTuner" aria-role="button" aria-label="{{messages.string}} {{item.number}} {{item.note}}">
        <text wx:if="{{selection.target && selection.target.number === item.number}}">{{item.number}} · {{item.note}}</text>
      </view>
    </view>
    <view class="tuners right">
      <view wx:for="{{rightTuners}}" wx:key="number" class="tuning-peg {{selection.target && selection.target.number === item.number ? 'selected' : ''}}" style="top: {{(161 + index * 120) / 720 * 100}}%;" data-number="{{item.number}}" bindtap="selectTuner" aria-role="button" aria-label="{{messages.string}} {{item.number}} {{item.note}}">
        <text wx:if="{{selection.target && selection.target.number === item.number}}">{{item.number}} · {{item.note}}</text>
      </view>
    </view>
  </view>
  <text class="target" wx:if="{{selection.target}}">{{messages.string}} {{selection.target.number}} · {{selection.target.note}}</text>
  <text class="target selection-hint" wx:else>{{messages.chooseString}}</text>
</view>
