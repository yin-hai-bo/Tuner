<import src="../../templates/usage-notice.wxml" />
<view class="tuner">
  <view class="pitch-grid {{pitchInTune ? 'in-tune' : ''}}" aria-hidden="true">
    <view class="pitch-trail">
      <view wx:for="{{pitchTrail}}" wx:key="id" class="pitch-trail-dot" style="left: {{50 + item.offset}}%; background: {{item.color}};"></view>
    </view>
  </view>
  <view class="toolbar">
    <label class="auto-control">
      <text>{{messages.automatic}}</text>
      <switch checked="{{selection.mode === 'auto'}}" color="#00cba9" bindchange="toggleAutomatic" aria-label="{{messages.automatic}}" />
    </label>
    <button wx:if="{{microphonePermission === 'denied'}}" class="microphone-button" disabled="{{permissionBusy}}" bindtap="openMicrophoneSettings">{{messages.openMicrophoneSettings}}</button>
    <button wx:elif="{{microphonePermission === 'error'}}" class="microphone-button" loading="{{permissionBusy}}" disabled="{{permissionBusy}}" bindtap="requestMicrophonePermission">{{messages.retryMicrophonePermission}}</button>
    <button wx:elif="{{microphonePermission === 'granted' && listeningStopped}}" class="microphone-button" bindtap="startRecording">{{recordingState === 'error' || recordingState === 'cleanup-error' ? messages.retryMicrophonePermission : messages.continueListening}}</button>
  </view>
  <text wx:if="{{microphonePermission === 'denied' || microphonePermission === 'error' || listeningStopped}}" class="microphone-notice">{{microphonePermission === 'denied' ? messages.microphoneRequired : microphonePermission === 'error' ? messages.microphonePermissionError : messages[recordingHintKey]}}</text>
  <view class="pitch-feedback">
    <view class="pitch-marker {{pitchInTune ? 'in-tune' : ''}} {{!pitchReading && pitchInputState !== 'uncertain' ? 'waiting' : ''}}" style="left: {{pitchReading ? 50 + pitchOffset : 50}}%; color: {{listeningStopped ? '#7b8580' : pitchMarkerColor}};">
      <view wx:if="{{pitchStable}}" class="pitch-check {{animateSuccess ? 'animate-success' : ''}}" aria-label="{{messages.inTune}}">
        <view class="check-short"></view>
        <view class="check-long"></view>
      </view>
      <text wx:elif="{{pitchReading}}" class="pitch-value">{{pitchDeviation > 0 ? '+' : ''}}{{pitchDeviation}}</text>
    </view>
    <text class="pitch-hint">{{pitchReading || pitchInputState === 'uncertain' ? messages[pitchHintKey] : listeningStopped ? '' : pluckHint}}</text>
  </view>
  <view class="headstock">
    <image class="headstock-image" src="/assets/guitar-headstock.svg" mode="aspectFit" aria-hidden="true"></image>
    <view wx:if="{{pitchReading}}" class="string-highlight detected-string" aria-hidden="true">
      <image class="headstock-image" src="/assets/string-highlights/string-{{pitchReading.target.number}}.svg" mode="aspectFit"></image>
    </view>
    <view class="tuners left">
      <view wx:for="{{leftTuners}}" wx:key="number" class="tuning-peg {{selection.target && selection.target.number === item.number ? 'selected' : ''}} {{automaticTarget === item.number ? 'detected' : ''}}" style="top: {{(161 + index * 120) / 720 * 100}}%;" data-number="{{item.number}}" bindtap="selectTuner" aria-role="button" aria-label="{{messages.string}} {{item.number}} {{item.note}}">
        <image class="tuning-peg-highlight" src="/assets/tuning-peg-highlight.svg" mode="scaleToFill" aria-hidden="true"></image>
        <text wx:if="{{(selection.target && selection.target.number === item.number) || (automaticTarget === item.number)}}">{{item.number}} · {{item.note}}</text>
      </view>
    </view>
    <view class="tuners right">
      <view wx:for="{{rightTuners}}" wx:key="number" class="tuning-peg {{selection.target && selection.target.number === item.number ? 'selected' : ''}} {{automaticTarget === item.number ? 'detected' : ''}}" style="top: {{(161 + index * 120) / 720 * 100}}%;" data-number="{{item.number}}" bindtap="selectTuner" aria-role="button" aria-label="{{messages.string}} {{item.number}} {{item.note}}">
        <image class="tuning-peg-highlight" src="/assets/tuning-peg-highlight.svg" mode="scaleToFill" aria-hidden="true"></image>
        <text wx:if="{{(selection.target && selection.target.number === item.number) || (automaticTarget === item.number)}}">{{item.number}} · {{item.note}}</text>
      </view>
    </view>
  </view>
  <text class="target" wx:if="{{selection.target}}">{{messages.string}} {{selection.target.number}} · {{selection.target.note}}</text>
  <text class="target" wx:elif="{{pitchReading}}">{{messages.string}} {{pitchReading.target.number}} · {{pitchReading.target.note}}</text>
  <text class="target selection-hint" wx:else>{{messages.chooseString}}</text>
  <text class="privacy-notice">{{messages.microphonePrivacy}}</text>
</view>
<view wx:if="{{licenseOpen}}" class="license-overlay" catchtouchmove="ignoreLicenseTouch">
  <view class="license-dialog" role="dialog" aria-modal="true" aria-label="{{messages.disclaimerTitle}}">
    <text class="license-title">{{messages.disclaimerTitle}}</text>
    <view class="license-textbox">
      <scroll-view scroll-y class="license-body">
        <view class="license-content">
          <template is="usage-notice" data="{{messages: messages}}" />
        </view>
      </scroll-view>
    </view>
    <checkbox-group bindchange="changeLicenseAgreement">
      <label class="license-agreement"><checkbox value="agree" checked="{{licenseChecked}}" color="#00cba9" /><text class="license-agreement-copy">{{messages.licenseAgree}}<text class="license-agreement-hint">{{messages.licenseAgreeHint}}</text></text></label>
    </checkbox-group>
    <text wx:if="{{licenseSaveFailed}}" class="license-error">{{messages.licenseSaveError}}</text>
    <button class="license-start" disabled="{{!licenseChecked}}" bindtap="acceptLicense">{{messages.licenseStart}}</button>
  </view>
</view>
