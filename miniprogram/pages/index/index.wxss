page {
  min-height: 100vh;
  background: #101413;
  color: #f2f5f3;
}

.tuner {
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 32rpx 12rpx;
}

.toolbar {
  width: 100%;
  margin-bottom: 32rpx;
}

.auto-control {
  display: flex;
  align-items: center;
  width: fit-content;
  gap: 12rpx;
  font-size: 24rpx;
  text-transform: uppercase;
}

.target {
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 40rpx;
}

.headstock {
  position: relative;
  width: 560rpx;
  height: 720rpx;
  flex-shrink: 0;
  margin-top: auto;
}

.headstock-image {
  display: block;
  width: 100%;
  height: 100%;
}

.tuners {
  position: absolute;
  top: 0;
  width: 12.5%; /* SVG tuning key width: 70 / 560. */
  height: 100%;
}
.tuners.left { left: 12.142857%; } /* 68 / 560. */
.tuners.right { left: 75.357143%; } /* 422 / 560. */

.tuning-peg {
  position: absolute;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 58rpx;
  border-radius: 22rpx;
  background: transparent;
  color: #15231b;
  font-family: Arial, sans-serif;
  font-size: 20rpx;
  font-weight: 700;
}
.tuning-peg.selected {
  background: linear-gradient(180deg, #9bffb0, #19ed68);
  box-shadow: 0 0 16rpx rgba(25, 237, 104, .65);
}
