page {
  min-height: 100vh;
  background: #101413;
  color: #f2f5f3;
}

.tuner {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 32rpx 12rpx;
}

.pitch-grid {
  position: absolute;
  top: 144rpx;
  left: 0;
  right: 0;
  bottom: 18%;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(172, 188, 180, .1) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(172, 188, 180, .1) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
  background-position: center top;
  animation: grid-drift 2s linear infinite;
}

/* Shift exactly one grid cell so the loop has no visible jump. */
@keyframes grid-drift {
  from { background-position: center 0; }
  to { background-position: center 40rpx; }
}

.pitch-trail {
  position: absolute;
  /* Match the marker's tip: 200 + 76 - border + 12, relative to grid top. */
  top: calc(141rpx - 1px);
  left: calc(50% - 280rpx);
  width: 560rpx;
}
.pitch-trail-dot {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: pitch-trail-drift 20s linear forwards;
}
/* Same speed as the grid: 40rpx every 2 seconds. */
@keyframes pitch-trail-drift {
  from { margin-top: 0; }
  to { margin-top: 400rpx; }
}

.pitch-grid::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 2rpx;
  transform: translateX(-50%);
  background: rgba(196, 213, 204, .3);
  transition: background-color .4s ease-in-out, width .4s ease-in-out;
}

.pitch-grid.in-tune::before {
  width: 4rpx;
  background-color: #16834b;
}

.pitch-grid::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(#101413, transparent 12%, transparent 55%, #101413);
}

.toolbar,
.headstock,
.target {
  position: relative;
  z-index: 1;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 160rpx;
}

.debug-toggle { margin: 0; font-size: 22rpx; background: #202925; color: #9aa7a1; }
.debug-panel {
  position: fixed;
  z-index: 10;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  box-sizing: border-box;
  max-height: 36vh;
  overflow-y: auto;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #202925;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, .35);
  font-size: 24rpx;
  line-height: 40rpx;
}
.debug-actions { display: flex; gap: 8rpx; margin-bottom: 16rpx; }
.debug-actions button { margin: 0; padding: 0 12rpx; font-size: 22rpx; }

.auto-control {
  display: flex;
  align-items: center;
  width: fit-content;
  gap: 12rpx;
  font-size: 24rpx;
  text-transform: uppercase;
}

.target {
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 40rpx;
}

.selection-hint {
  color: #78817c;
  font-size: 24rpx;
  text-align: center;
}

.headstock {
  position: relative;
  width: 600rpx;
  height: 771.428571rpx; /* Preserve the SVG's 560:720 aspect ratio. */
  flex-shrink: 0;
  margin-top: auto;
}

/* The artwork starts at y=76; finish fading just before it, at y=72. */
.headstock::before {
  content: '';
  position: absolute;
  z-index: -1;
  top: -128rpx;
  left: calc(50% - 50vw);
  width: 100vw;
  height: calc(100% + 128rpx);
  pointer-events: none;
  background: linear-gradient(transparent, #101413 200rpx);
}

.headstock-image {
  display: block;
  width: 100%;
  height: 100%;
}

.pitch-feedback {
  position: absolute;
  z-index: 2;
  top: 200rpx;
  left: calc(50% - 280rpx);
  width: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.string-highlight {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.pitch-hint {
  margin-top: 84rpx;
  color: #a7b2ac;
  font-size: 24rpx;
  line-height: 40rpx;
}

.pitch-marker {
  position: relative;
  align-self: flex-start;
  transform: translateX(-50%);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: calc(3rpx + 1px) solid currentColor;
  border-radius: 50%;
  background: #171c1a;
  color: #7b8580;
  font-size: 28rpx;
  transition: left .12s ease-out, color .12s linear, background-color .12s linear;
}
.pitch-marker::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-top: 12rpx solid currentColor;
}
.pitch-marker.in-tune { background-color: #16834b; }
.pitch-marker.waiting { color: #f2f5f3; }
.pitch-value { color: #f2f5f3; }
.pitch-check {
  position: relative;
  width: 36rpx;
  height: 32rpx;
  transform: translate(4rpx, 2rpx);
}
.check-short, .check-long {
  position: absolute;
  height: 4rpx;
  transform-origin: left center;
}
.check-short { left: 0; top: 13rpx; width: 16rpx; transform: rotate(45deg); }
.check-long { left: 11.3rpx; top: 24.3rpx; width: 28rpx; transform: rotate(-48deg); }
.check-short::after, .check-long::after {
  content: '';
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 2rpx;
  background: #f2f5f3;
  transform: scaleX(0);
  transform-origin: left center;
  animation: check-stroke .12s linear forwards;
}
/* Continue from the first stroke's endpoint, completing the check in 0.4s. */
.check-long::after { animation-duration: .28s; animation-delay: .12s; }
@keyframes check-stroke {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}
.tuning-peg.detected {
  animation: detected-pulse .9s ease-in-out infinite;
}
.string-highlight.detected-string { animation: detected-pulse .9s ease-in-out infinite; }
@keyframes detected-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .35; }
}

.tuners {
  position: absolute;
  top: 0;
  width: 12.5%; /* SVG tuning key width: 70 / 560. */
  height: 100%;
}
.tuners.left { left: 12.142857%; } /* 68 / 560. */
.tuners.right { left: 75.357143%; } /* 422 / 560. */

.tuning-peg {
  position: absolute;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 8.055556%; /* SVG tuning key height: 58 / 720. */
  border-radius: 22rpx;
  background: transparent;
  color: #15231b;
  font-family: Arial, sans-serif;
  font-size: 20rpx;
  font-weight: 700;
}
.tuning-peg-highlight {
  display: none;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.tuning-peg.selected .tuning-peg-highlight,
.tuning-peg.detected .tuning-peg-highlight { display: block; }
.tuners.right .tuning-peg-highlight { transform: scaleX(-1); }
.tuning-peg text { position: relative; }
