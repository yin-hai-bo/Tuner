page {
  min-height: 100vh;
  background: #101413;
  color: #f2f5f3;
}

.tuner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 16rpx;
  color: #9aa7a1;
  font-size: 26rpx;
}

.languages {
  display: flex;
  margin-top: 32rpx;
}

.language {
  margin: 0 8rpx;
  padding: 0 24rpx;
  background: #202925;
  color: #9aa7a1;
  font-size: 26rpx;
}

.language.selected {
  color: #f2f5f3;
  background: #365647;
}
