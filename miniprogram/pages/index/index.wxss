page {
  min-height: 100vh;
  background: #101413;
  color: #f2f5f3;
}

.tuner {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 32rpx 12rpx;
}

.pitch-grid {
  position: absolute;
  top: 144rpx;
  left: 0;
  right: 0;
  bottom: 18%;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(172, 188, 180, .1) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(172, 188, 180, .1) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
  background-position: center top;
}

.pitch-grid::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 2rpx;
  transform: translateX(-50%);
  background: rgba(196, 213, 204, .3);
}

.pitch-grid::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(#101413, transparent 12%, transparent 55%, #101413);
}

.toolbar,
.headstock,
.target {
  position: relative;
  z-index: 1;
}

.toolbar {
  width: 100%;
  margin-bottom: 160rpx;
}

.auto-control {
  display: flex;
  align-items: center;
  width: fit-content;
  gap: 12rpx;
  font-size: 24rpx;
  text-transform: uppercase;
}

.target {
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 40rpx;
}

.selection-hint {
  color: #78817c;
  font-size: 24rpx;
  text-align: center;
}

.headstock {
  position: relative;
  width: 560rpx;
  height: 720rpx;
  flex-shrink: 0;
  margin-top: auto;
}

.headstock-image {
  display: block;
  width: 100%;
  height: 100%;
}

.pitch-feedback {
  position: absolute;
  bottom: calc(100% - 40rpx);
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.string-highlight {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  animation: string-decay 3s linear forwards;
}

/* Approximate the reference tone's fast attack and quieter sustained tail. */
@keyframes string-decay {
  0% { opacity: 1; }
  10% { opacity: .55; }
  30% { opacity: .28; }
  60% { opacity: .13; }
  90% { opacity: .06; }
  100% { opacity: 0; }
}

.pitch-hint {
  margin-top: 16rpx;
  color: #a7b2ac;
  font-size: 24rpx;
  line-height: 40rpx;
}

.tuners {
  position: absolute;
  top: 0;
  width: 12.5%; /* SVG tuning key width: 70 / 560. */
  height: 100%;
}
.tuners.left { left: 12.142857%; } /* 68 / 560. */
.tuners.right { left: 75.357143%; } /* 422 / 560. */

.tuning-peg {
  position: absolute;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 58rpx;
  border-radius: 22rpx;
  background: transparent;
  color: #15231b;
  font-family: Arial, sans-serif;
  font-size: 20rpx;
  font-weight: 700;
}
.tuning-peg.selected {
  background: linear-gradient(180deg, #9bffb0, #19ed68);
  box-shadow: 0 0 16rpx rgba(25, 237, 104, .65);
}
